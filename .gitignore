# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
graphify-out/

# La maquette complète du motion design (python3 docs/motion-aplat/build.py la régénère) : ses milliers de nombres
# tirés au hasard peuvent ressembler à une valeur du chiffrage (tests/frontiere-chiffrage.test.ts). Seules les scènes
# extraites (src/components/motion-aplat.genere.ts) entrent dans le dépôt.
docs/motion-aplat/index.html
